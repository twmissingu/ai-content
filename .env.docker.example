# ═══════════════════════════════════════════════════════════════════════
# 稿定 — AI Content Production System Docker 配置模板
# 复制本文件为 .env 并填入你的配置：
#   cp .env.docker.example .env
# ═══════════════════════════════════════════════════════════════════════

# ── LLM Provider ─────────────────────────────────────────────────────
# 必填。LLM API 地址，兼容 OpenAI 格式。
LLM_BASE_URL="https://api.xiaomimimo.com/v1"

# 必填。LLM API Key
XIAOMI_API_KEY="your-api-key-here"

# 模型名称（可选，默认 mimo-v2.5）
LLM_MODEL="mimo-v2.5"

# ── Authentication ───────────────────────────────────────────────────
# API 认证密钥（生产环境必须设置，ENV=production 时未设会拒绝所有请求）
API_KEY=""

# 运行环境：development / production / staging
ENV="development"

# ── CORS ─────────────────────────────────────────────────────────────
# 允许的前端域名（逗号分隔，本地开发使用默认值即可）
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8710,http://127.0.0.1:8710"

# ── Feishu Notification ─────────────────────────────────────────────
# 飞书 Webhook URL（可选，用于接收系统告警通知）
FEISHU_WEBHOOK_URL=""

# ── Budget ───────────────────────────────────────────────────────────
# 月度预算上限（美元，可选，默认 15）
MONTHLY_BUDGET_USD=15
